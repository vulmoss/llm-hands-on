# 复制为 .env 后执行：set -a; source .env; set +a
# 这里填写 Ollama 原生 API 根地址，不加 /v1 或 /api。
OLLAMA_BASE_URL=http://127.0.0.1:11434
# 使用原有 VM1 时改为 http://192.168.2.15:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_EMBED_MODEL=all-minilm:33m
OLLAMA_TIMEOUT=120
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=512
LLM_HISTORY_TURNS=10
LLM_MAX_TOOL_CALLS=6
LLM_INDEX_PATH=.data/index.json
